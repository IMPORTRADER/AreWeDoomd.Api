<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.27" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AreWeDoomd.Application\AreWeDoomd.Application.csproj" />
    <ProjectReference Include="..\AreWeDoomd.Infrastructure\AreWeDoomd.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Contracts\**\*.cs" />
    <Compile Update="Controllers\AuthController.cs" />
  </ItemGroup>

</Project>

